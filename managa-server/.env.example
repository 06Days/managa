# Port for the managa server.
PORT=5100

# Where built-in apps and installed GitHub apps are discovered.
# Defaults to the parent directory when the server is started from managa-server/.
# MANAGA_ROOT_DIR=..

# Registry, cloned apps and logs live here.
# MANAGA_DATA_DIR=../data

# Re-start apps that were toggled on before the managa server stopped.
AUTO_START=true

# Optional remote JSON catalog (array of catalog entries or { "apps": [...] }).
# MANAGA_CATALOG_URL=

# Public base URL used for app links and app client API URLs. In Docker this
# must be the address used to reach the host, not localhost, unless you only
# open the dashboard from the host itself.
# MANAGA_PUBLIC_HOST=http://localhost

# Set to false to disable git installs entirely.
MANAGA_ALLOW_GIT=true

# Dev-only: allow installing a git repository from a local path or file:// URL.
# Keep this false outside development.
MANAGA_ALLOW_LOCAL_SOURCES=false
