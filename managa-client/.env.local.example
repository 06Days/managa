# URL of the managa server (NestJS).
# When omitted, the dashboard talks to <current-host>:5100.
NEXT_PUBLIC_MANAGA_API_URL=http://localhost:5100

# Internal managa server URL used by the /mcp proxy. This is server-side only.
# When omitted, the dashboard proxies /mcp to http://127.0.0.1:5100/mcp.
MANAGA_SERVER_URL=http://127.0.0.1:5100
